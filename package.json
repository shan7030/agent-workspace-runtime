{
  "name": "agent-runtime-lab",
  "version": "1.0.0",
  "description": "OpenAI Agents API playground with a self-hosted workspace runtime, Kubernetes pods, and PVC-backed session workspaces.",
  "main": "src/openai-agents-server.js",
  "scripts": {
    "start": "node --env-file=.env src/openai-agents-server.js",
    "dev": "nodemon --exec \"node --env-file=.env\" src/openai-agents-server.js",
    "start:agents": "node --env-file=.env src/openai-agents-server.js",
    "dev:agents": "nodemon --exec \"node --env-file=.env\" src/openai-agents-server.js",
    "dev:client": "npm --prefix client run dev -- --host 127.0.0.1",
    "build:client": "npm --prefix client run build",
    "build:runtime": "docker build -t agent-runtime:local ./runtime"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "openai": "^7.15.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.14"
  }
}
